{
  "name": "viget-parts-kit",
  "version": "2.0.0",
  "description": "A browsable, theme-styled kit of every registered block, plus a Block Index showing where each block is used.",
  "author": "Viget",
  "license": "GPL-2.0-or-later",
  "files": [
    "build",
    "includes",
    "views",
    "languages",
    "viget-parts-kit.php",
    "uninstall.php",
    "readme.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "format": "wp-scripts format",
    "plugin-zip": "wp-scripts plugin-zip",
    "packages-update": "wp-scripts packages-update",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "update-pot": "wp-env run cli wp i18n make-pot wp-content/plugins/viget-parts-kit wp-content/plugins/viget-parts-kit/languages/viget-parts-kit.pot --exclude=src,node_modules,tests,bin",
    "version": "node bin/sync-version.js && git add viget-parts-kit.php readme.txt",
    "postversion": "git push && git push --tags",
    "release": "npm version"
  },
  "devDependencies": {
    "@wordpress/env": "^11.15.0",
    "@wordpress/scripts": "^35.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/block-editor": "^19.0.0",
    "@wordpress/blocks": "^17.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/data": "^11.0.0",
    "@wordpress/dom-ready": "^5.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/hooks": "^5.0.0",
    "@wordpress/i18n": "^7.0.0"
  }
}
