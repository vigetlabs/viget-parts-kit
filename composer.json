{
  "name": "viget/viget-parts-kit",
  "description": "A browsable, theme-styled kit of every registered block, plus a Block Index showing where each block is used.",
  "keywords": [
    "wordpress",
    "blocks",
    "gutenberg",
    "parts-kit",
    "pattern-library",
    "qa",
    "block-index"
  ],
  "type": "wordpress-plugin",
  "homepage": "https://github.com/vigetlabs/viget-parts-kit",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Viget",
      "homepage": "https://viget.com/"
    }
  ],
  "require": {
    "composer/installers": "^1.0 || ^2.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "8.2"
    }
  }
}
